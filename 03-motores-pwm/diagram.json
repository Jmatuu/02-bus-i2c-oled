  "connections": [
    ["oled1:GND", "esp:GND.1", "black", []],
    ["oled1:VCC", "esp:3V3", "red", []],
    ["oled1:SDA", "esp:21", "blue", []],
    ["oled1:SCL", "esp:22", "yellow", []],

    ["esp:25", "res25:1", "green", []],
    ["res25:2", "led25:A", "green", []],
    ["led25:C", "esp:GND.1", "black", []],

    ["esp:26", "res26:1", "green", []],
    ["res26:2", "led26:A", "green", []],
    ["led26:C", "esp:GND.1", "black", []],

    ["esp:27", "res27:1", "green", []],
    ["res27:2", "led27:A", "green", []],
    ["led27:C", "esp:GND.1", "black", []],

    ["esp:14", "res14:1", "green", []],
    ["res14:2", "led14:A", "green", []],
    ["led14:C", "esp:GND.1", "black", []]
