{
  "version": 1,
  "author": "03-motores-pwm - LEDs como indicadores de velocidad",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "board-ssd1306",
      "id": "oled1",
      "top": -130,
      "left": 250,
      "attrs": { "i2cAddress": "0x3C" }
    },
    {
      "type": "wokwi-resistor",
      "id": "res25",
      "top": 40,
      "left": 250,
      "attrs": { "value": "330" }
    },
    {
      "type": "wokwi-resistor",
      "id": "res26",
      "top": 130,
      "left": 250,
      "attrs": { "value": "330" }
    },
    {
      "type": "wokwi-resistor",
      "id": "res27",
      "top": 220,
      "left": 250,
      "attrs": { "value": "330" }
    },
    {
      "type": "wokwi-resistor",
      "id": "res14",
      "top": 310,
      "left": 250,
      "attrs": { "value": "330" }
    },
    {
      "type": "wokwi-led",
      "id": "led25",
      "top": 30,
      "left": 370,
      "attrs": { "color": "red", "label": "GPIO 25 - M1 adelante" }
    },
    {
      "type": "wokwi-led",
      "id": "led26",
      "top": 120,
      "left": 370,
      "attrs": { "color": "orange", "label": "GPIO 26 - M1 atras" }
    },
    {
      "type": "wokwi-led",
      "id": "led27",
      "top": 210,
      "left": 370,
      "attrs": { "color": "blue", "label": "GPIO 27 - M2 adelante" }
